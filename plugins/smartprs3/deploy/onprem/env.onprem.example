# SmartPRS 3 - ON-PREMISES client server. INSTALL-Windows.bat / INSTALL-Linux.sh copies this to .env and fills
# the database lines, APP_KEY and APP_URL itself (it asks only for the MySQL root password). Nothing to edit by hand.
# Back up .env after install - it cannot be re-created.

APP_NAME="SmartPRS 3"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=Asia/Kolkata
SMARTPRS_DEFAULT_BUSINESS_TIMEZONE=Asia/Kolkata
SMARTPRS_DEFAULT_CURRENCY=INR

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smartprs3
# The application's account (no CREATE/ALTER/DROP - the installer grants it table by table).
DB_USERNAME=smartprs3_app
DB_PASSWORD=
# Runs the database updates only.
DB_MIGRATION_USERNAME=smartprs3_migrator
DB_MIGRATION_PASSWORD=

MAIL_MAILER=smtp
MAIL_FROM_ADDRESS="no-reply@smartprs.com"
MAIL_FROM_NAME="SmartPRS"

# ---- Licensing: this server is licensed by Ametecs (smartprs.com) ----
SMARTPRS_DEPLOYMENT=onprem
SMARTPRS_LICENCE_SERVER=https://smartprs.com
SMARTPRS_LICENCE_ENFORCE=true
# true only for a server with no internet: activates with a machine-locked .lic file from Ametecs.
SMARTPRS_OFFLINE_LIC=false

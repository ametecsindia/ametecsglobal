# AmetecsGlobal: the old address global/... moved to core/... on 17 Nov 2026 - old bookmarks and links still work.
RedirectMatch 301 "^((?:(?!/plugins/).)*)/global/(.*)$" "$1/core/$2"
# A client's own sign-in link: <AmetecsGlobal>/c/<slug> (like SmartPRS3's company links). App folders keep their own /c/ links.
RedirectMatch 302 "^((?:(?!/plugins/).)*)/c/([A-Za-z0-9]+)/?$" "$1/core/?c=$2"
